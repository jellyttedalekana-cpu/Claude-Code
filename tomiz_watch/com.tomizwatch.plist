<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tomizwatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/YOUR_NAME/tomiz-watch/watch.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TOMIZ_WATCH_GMAIL_APP_PASSWORD</key>
        <string>xxxxxxxxxxxxxxxx</string>
    </dict>

    <!-- 30分おき。短くしすぎるとサイトに負荷をかけるので 1800 秒以上を推奨 -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_NAME/tomiz-watch/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_NAME/tomiz-watch/launchd.err.log</string>
</dict>
</plist>
